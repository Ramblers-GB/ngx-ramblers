#!/usr/bin/env bash
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"

find_checkout_root() {
  local dir="$1"
  while [ "$dir" != "/" ]; do
    if [ -f "$dir/fly.toml" ]; then
      echo "$dir"
      return 0
    fi
    dir="$(dirname "$dir")"
  done
  return 1
}

PROJECT_ROOT="$(find_checkout_root "$PWD")" || PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
cd "$PROJECT_ROOT"

HASH_FILE="node_modules/.install-hash"

compute_hash() {
  local hasher="sha256sum"
  command -v shasum >/dev/null 2>&1 && hasher="shasum -a 256"
  cat package-lock.json server/package-lock.json 2>/dev/null | $hasher | cut -d' ' -f1
}

needs_install() {
  [ ! -d "node_modules" ] && return 0
  [ ! -f "$HASH_FILE" ] && return 0

  current_hash=$(compute_hash)
  stored_hash=$(cat "$HASH_FILE" 2>/dev/null)

  [ "$current_hash" != "$stored_hash" ] && return 0

  [ ! -x "node_modules/.bin/ts-node" ] && return 0
  [ ! -x "node_modules/.bin/ng" ] && return 0

  return 1
}

major_version() {
  echo "${1#v}" | cut -d. -f1
}

toolchain_help() {
  echo "NGX needs Node $required_node and npm $required_npm." >&2
  echo "Install them with nvm (https://github.com/nvm-sh/nvm), then run:" >&2
  echo "  nvm install $required_node && nvm use $required_node && npm install --global npm@$required_npm" >&2
  echo "On macOS, Node $(major_version "$required_node") needs macOS 13.5 or newer." >&2
}

check_toolchain() {
  required_node="$(tr -d '[:space:]' < .nvmrc)"
  required_npm="$(sed -n 's/.*"npm": *"\([^"]*\)".*/\1/p' package.json | head -1)"
  if ! command -v node >/dev/null 2>&1 || ! command -v npm >/dev/null 2>&1; then
    echo "Node.js and npm were not found." >&2
    toolchain_help
    exit 1
  fi
  local node_version npm_version
  node_version="$(node --version)"
  npm_version="$(npm --version)"
  if [ "$(major_version "$node_version")" != "$(major_version "$required_node")" ] || [ "$(major_version "$npm_version")" != "$(major_version "$required_npm")" ]; then
    echo "Found Node $node_version and npm $npm_version." >&2
    toolchain_help
    exit 1
  fi
  if [ "$node_version" != "$required_node" ] || [ "$npm_version" != "$required_npm" ]; then
    echo "Warning: found Node $node_version and npm $npm_version; NGX is pinned to Node $required_node and npm $required_npm." >&2
  fi
}

check_toolchain

if needs_install; then
  echo "Installing dependencies..."
  if npm install && npm install --prefix server; then
    compute_hash > "$HASH_FILE"
  else
    rm -f "$HASH_FILE"
    echo "Dependency install failed. Fix the error above, then run ./bin/ngx-cli again." >&2
    echo "If it keeps failing, start clean with: npm run reinstall" >&2
    exit 1
  fi
fi

./node_modules/.bin/ts-node server/lib/cli/index.ts "$@"
